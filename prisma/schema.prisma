// ============================================================
// GHARMAI DRINKS — Prisma Schema (SQLite, zero-config)
// Swap `provider` to "postgresql" + DATABASE_URL for production.
// Enums are stored as strings; array fields (images/tags) as JSON text.
// ============================================================
generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the rhel target is what Netlify/AWS Lambda functions run on.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- CATALOG ----------
model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryToSub", fields: [parentId], references: [id])
  subs      Category[] @relation("CategoryToSub")
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  products  Product[]
  createdAt DateTime   @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("") // rich text / HTML
  price       Int // whole rupees (NPR)
  compareAt   Int? // original price for "was" display
  images      String   @default("[]") // JSON array of media URLs
  badge       String   @default("NONE") // NONE | PREMIUM | POPULAR | LIMITED | VALUE | NEW
  tags        String   @default("[]") // JSON array
  stock       String   @default("IN_STOCK") // IN_STOCK | LOW_STOCK | OUT_OF_STOCK
  featured    Boolean  @default(false)
  sponsored   Boolean  @default(false) // shows "Sponsored" in grid
  luxury      Boolean  @default(false) // shows in Premium / Reserve collection
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  // SEO
  metaTitle       String?
  metaDescription String?

  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([categoryId])
  @@index([active, featured])
  @@index([luxury])
}

// ---------- BRANDS (Brand Spotlight ad panel) ----------
model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logo        String? // brand logo/mark URL
  bannerImage String? // wide hero image for the spotlight
  tagline     String?
  description String    @default("")
  accent      String    @default("#D4AF37") // brand accent color
  linkUrl     String?
  featured    Boolean   @default(true) // show in storefront spotlight
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---------- ADS & PROMOTIONS ENGINE ----------
model BannerAd {
  id          String  @id @default(cuid())
  title       String
  headline    String?
  subtext     String?
  buttonLabel String?
  linkUrl     String?
  mediaUrl    String?
  mediaType   String  @default("image") // image | video
  placement   String // HERO | TOP_BAR | MID_PAGE | SPONSORED_CARD | POPUP | EXIT_INTENT | FLASH_SALE | SEASONAL
  audience    String  @default("ALL") // ALL | NEW_VISITORS | VIP_ONLY | MOBILE_ONLY
  priority    Int     @default(0)
  startAt     DateTime?
  endAt       DateTime?
  active      Boolean   @default(true)
  frequency   String? // once_per_session | once_per_day

  impressions Int @default(0)
  clicks      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, active])
}

model Promotion {
  id           String    @id @default(cuid())
  code         String    @unique
  description  String    @default("")
  type         String    @default("PERCENT") // PERCENT | FIXED | BOGO
  value        Int
  minOrder     Int       @default(0)
  bogoBuyQty   Int?
  bogoGetQty   Int?
  usageLimit   Int?
  usageCount   Int       @default(0)
  perUserLimit Int?
  startAt      DateTime?
  endAt        DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------- BLOG ----------
model Post {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  excerpt         String     @default("")
  body            String     @default("")
  coverImage      String?
  status          String     @default("DRAFT") // DRAFT | SCHEDULED | PUBLISHED
  publishAt       DateTime?
  metaTitle       String?
  metaDescription String?
  authorId        String?
  author          AdminUser? @relation(fields: [authorId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, publishAt])
}

// ---------- MEDIA ----------
model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  publicId  String?
  type      String   @default("image")
  filename  String
  bytes     Int      @default(0)
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
}

// ---------- ORDERS ----------
model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  customerName String
  phone        String
  address      String
  mapsLink     String?
  notes        String?
  subtotal     Int
  deliveryFee  Int         @default(0)
  discount     Int         @default(0)
  total        Int
  couponCode   String?
  status       String      @default("RECEIVED") // RECEIVED | PREPARING | OUT_FOR_DELIVERY | DELIVERED | CANCELLED
  whatsappLog  String?
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id])
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  price     Int
  quantity  Int
}

// ---------- CUSTOMERS & VIP ----------
model Customer {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?
  vipTier      String   @default("NONE") // NONE | SILVER | GOLD | PLATINUM | BLACK_CARD
  rewardPoints Int      @default(0)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------- HOMEPAGE CONTENT ----------
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  body      String
  rating    Int      @default(5)
  avatar    String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ---------- ADMIN & AUDIT ----------
model AdminUser {
  id        String        @id @default(cuid())
  name      String
  email     String        @unique
  password  String
  role      String        @default("CONTENT_EDITOR") // SUPER_ADMIN | CONTENT_EDITOR | ORDER_MANAGER
  active    Boolean       @default(true)
  posts     Post[]
  logs      ActivityLog[]
  createdAt DateTime      @default(now())
}

model ActivityLog {
  id        String     @id @default(cuid())
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id])
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime   @default(now())

  @@index([createdAt])
}
